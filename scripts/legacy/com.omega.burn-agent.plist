<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Omega Burn Agent LaunchAgent
  
  This plist runs the burn agent automatically when you log in.
  The agent will poll the Cloud Manager for jobs and burn them locally.
  
  Installation:
    cp scripts/com.omega.burn-agent.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.omega.burn-agent.plist
  
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.omega.burn-agent.plist
    rm ~/Library/LaunchAgents/com.omega.burn-agent.plist
  
  View logs:
    tail -f /tmp/omega-burn-agent.log
    tail -f /tmp/omega-burn-agent.err
  
  Check status:
    launchctl list | grep omega
-->
<dict>
    <key>Label</key>
    <string>com.omega.burn-agent</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/haukurhauksson/Azotus/scripts/burn_agent.py</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/haukurhauksson/Azotus</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Cloud Manager Connection -->
        <key>OMEGA_CLOUD_MANAGER_URL</key>
        <string>https://omega-cloud-manager-XXXXX.run.app</string>
        
        <key>OMEGA_CLOUD_MANAGER_TOKEN</key>
        <string>YOUR_TOKEN_HERE</string>
        
        <key>OMEGA_BURN_AGENT_ID</key>
        <string>haukur-macbook</string>
        
        <!-- Directories -->
        <key>OMEGA_BURN_OUTPUT_DIR</key>
        <string>/Volumes/Extreme SSD/4_DELIVERY/VIDEO</string>
        
        <key>OMEGA_BURN_CACHE_DIR</key>
        <string>/Volumes/Extreme SSD/4_DELIVERY/BURN_CACHE</string>
        
        <!-- Google Cloud credentials -->
        <key>GOOGLE_APPLICATION_CREDENTIALS</key>
        <string>/Users/haukurhauksson/Azotus/service_account.json</string>
        
        <!-- Optional: Default delivery profile -->
        <key>OMEGA_BURN_DELIVERY_PROFILE</key>
        <string>source</string>
    </dict>
    
    <!-- Run at login -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- Keep running -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    
    <!-- Restart on crash -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    
    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/tmp/omega-burn-agent.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/omega-burn-agent.err</string>
</dict>
</plist>
